# CMake toolchain: the Windows host (host/win/) cross-compiled from a Mac with clang-cl and lld-link (Homebrew
# llvm + lld) against the MSVC CRT and Windows SDK that xwin splats into tools/sdk/xwin/splat (tools/win.mjs --cross).
# On Windows none of this is needed: configure host/ from a Visual Studio prompt with Ninja.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(LLVM_BIN /opt/homebrew/opt/llvm/bin CACHE PATH "clang-cl, llvm-lib, llvm-rc, llvm-mt")
set(LLD_BIN /opt/homebrew/opt/lld/bin CACHE PATH "lld-link")
set(XWIN ${CMAKE_CURRENT_LIST_DIR}/sdk/xwin/splat CACHE PATH "xwin splat output")
set(CMAKE_C_COMPILER ${LLVM_BIN}/clang-cl)
set(CMAKE_CXX_COMPILER ${LLVM_BIN}/clang-cl)
set(CMAKE_LINKER ${LLD_BIN}/lld-link)
set(CMAKE_AR ${LLVM_BIN}/llvm-lib)
set(CMAKE_RC_COMPILER ${LLVM_BIN}/llvm-rc)
set(CMAKE_MT ${LLVM_BIN}/llvm-mt)
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
set(_inc "/imsvc ${XWIN}/crt/include /imsvc ${XWIN}/sdk/include/ucrt /imsvc ${XWIN}/sdk/include/um /imsvc ${XWIN}/sdk/include/shared /imsvc ${XWIN}/sdk/include/winrt")
set(CMAKE_C_FLAGS_INIT "${_inc}")
set(CMAKE_CXX_FLAGS_INIT "${_inc}")
set(_lib "/libpath:${XWIN}/crt/lib/x86_64 /libpath:${XWIN}/sdk/lib/um/x86_64 /libpath:${XWIN}/sdk/lib/ucrt/x86_64")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_lib}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_lib}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_TRY_COMPILE_CONFIGURATION Release)  # the splat carries no debug CRT (msvcrtd)
